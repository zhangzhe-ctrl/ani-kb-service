# kb-service 配置模板（KB-SPLIT-P3A / issue-061，ADR 0001 §四 #5 / §五-阶段3）
#
# 复制为 `.env`（本文件同目录，即 kb-service 仓库根）供 kb-service 加载。
# kb-service 只读本目录的 `.env`，不再读取 monorepo 根的共享 `.env`
# （config.py `_KB_ENV_FILE` 以绝对路径锚定）。进程环境变量优先级高于
# `.env` 文件；键大小写不敏感（pydantic-settings）。
#
# 警告：`.env` 不得提交到版本控制。所有敏感项（PG/对象存储/向量库/缓存
# 凭据）本文件中一律为占位符；生产环境由 K8s Secret 注入对应的环境变量，
# 不要在本文件写真实凭据。

# ── gRPC 服务 ─────────────────────────────────────────────────────────────────
GRPC_PORT=50053

# ── 数据库（敏感：PG 凭据）────────────────────────────────────────────────────
# kb 专属 PostgreSQL 实例（deploy/docker/docker-compose.kb-pg.yml：
# 127.0.0.1:5433/kb）。生产由 K8s Secret 注入 DATABASE_URL。
DATABASE_URL=postgresql://ani_app_user:<PG_PASSWORD>@localhost:5433/kb

# ── rag-engine gRPC（无状态 Parse/Embed/Generate）─────────────────────────────
RAG_ENGINE_GRPC_ADDR=localhost:50052

# ── 向量库 Milvus（D1 自管直连；敏感：Milvus 凭据）───────────────────────────
MILVUS_ADDR=localhost:19530
# 无鉴权连接留空；生产凭据由 K8s Secret 注入。
MILVUS_TOKEN=
MILVUS_TIMEOUT=10.0

# ── 对象存储 MinIO（D1 自管 bucket；敏感：access/secret key）─────────────────
# 内网/ClusterIP 视角（stat）；对外 NodePort 视角用于 presign，留空回落内网。
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=
# 生产凭据由 K8s Secret 注入（MinIO service account）。
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
# 兼容键：MINIO_USE_SSL 与 MINIO_SECURE 均可（AliasChoices）。
MINIO_SECURE=false
MINIO_BUCKET=ani-kb-docs
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL_SECONDS=900

# ── inference-service gRPC（控制面：解析 served_model_name → 运行时端点）──────
INFERENCE_SERVICE_GRPC_ADDR=inference-service.ani-system.svc.cluster.local:9104

# ── NATS（outbox 投递；敏感：认证如涉及）─────────────────────────────────────
NATS_URL=nats://localhost:4222
# v2 为唯一解析路径（KB-SPLIT-P4A / #064）；消费者常开，无 v1 subject 与开关。
NATS_PARSE_SUBJECT_V2=ani.tasks.kb.parse.v2
NATS_REBUILD_SUBJECT=ani.tasks.kb.rebuild.v1
# kb-service 整库重建消费者开关（默认 OFF）。
KB_REBUILD_CONSUMER_ENABLED=false

# ── Redis（会话缓存；敏感：认证如涉及）───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Embedding（kb 专属键；与 rag-engine 能力合同对齐）────────────────────────
# KB_EMBEDDING_MODEL：无默认向量模型，必填。CreateKB 优先用请求体显式值，
# 缺省时回落本值；两者都为空则返回 INVALID_ARGUMENT（不静默用默认模型）。
# SiliconFlow 端点只认全名前缀（如 "BAAI/bge-m3"；裸名 "bge-m3" 会
# model_not_found）。旧共享键 EMBEDDING_MODEL / EMBEDDING_DIM 仍可读
# （AliasChoices 兼容），新部署请用 KB_ 前缀键。示例（按需启用）：
# KB_EMBEDDING_MODEL=BAAI/bge-m3
KB_EMBEDDING_MODEL=
# KB_EMBEDDING_DIM：维度探测失败时的回退值（非维度真源；正常按所选模型
# 实测 dimension 自适应）。
KB_EMBEDDING_DIM=1024
